<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ========== HEADER GRADIENT ========== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="140dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:background="@drawable/bg_about_header" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.15"
                    android:text="NX TIMER"
                    android:textColor="#CCFFFFFF"
                    android:textSize="28sp" />
            </FrameLayout>

            <!-- ========== AVATAR + NAME ========== -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/about_image"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="-50dp"
                android:contentDescription="@string/creator_name"
                android:scaleType="centerCrop"
                android:src="@drawable/transaction_001_9"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CircleImage"
                app:strokeColor="@color/avatar_ring"
                app:strokeWidth="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/creator_name"
                android:textColor="@color/text_main"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_about_role"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:paddingHorizontal="16dp"
                android:paddingVertical="5dp"
                android:text="@string/creator_role"
                android:textColor="@color/primary"
                android:textSize="12sp" />

            <!-- ========== BIO ========== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:lineSpacingExtra="5dp"
                android:text="@string/creator_bio"
                android:textColor="@color/text_muted"
                android:textSize="13.5sp" />

            <!-- ========== DIVIDER ========== -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:background="@color/divider" />

            <!-- ========== CONTRIBUTORS ========== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/section_contributors"
                android:textColor="@color/about_section_title"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:weightSum="4">

                <!-- Contributor 1 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_contributor_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_contributor_avatar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/contributor_1_name"
                        android:textColor="@color/text_main"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="@string/contributor_1_role"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Contributor 2 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_contributor_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_contributor_avatar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/contributor_2_name"
                        android:textColor="@color/text_main"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="@string/contributor_2_role"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Contributor 3 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_contributor_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_contributor_avatar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/contributor_3_name"
                        android:textColor="@color/text_main"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="@string/contributor_3_role"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Contributor 4 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_contributor_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <View
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_contributor_avatar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/contributor_4_name"
                        android:textColor="@color/text_main"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="@string/contributor_4_role"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ========== TECH STACK ========== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/section_tech"
                android:textColor="@color/about_section_title"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_tech_chip"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="@string/tech_android"
                    android:textColor="@color/about_tech_chip_text"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_tech_chip"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="@string/tech_kotlin"
                    android:textColor="@color/about_tech_chip_text"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_tech_chip"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="@string/tech_java"
                    android:textColor="@color/about_tech_chip_text"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tech_chip"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="@string/tech_material"
                    android:textColor="@color/about_tech_chip_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ========== LINKS ========== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/section_links"
                android:textColor="@color/about_section_title"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:drawablePadding="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="🌐 Website"
                    android:textColor="@color/about_link_text"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:drawablePadding="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="🐙 GitHub"
                    android:textColor="@color/about_link_text"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="📧 Email"
                    android:textColor="@color/about_link_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ========== DIVIDER ========== -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="18dp"
                android:background="@color/divider" />

            <!-- ========== FOOTER ========== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="@string/app_version"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="@string/about_copyright"
                android:textColor="@color/about_copyright_text"
                android:textSize="10sp" />

            <!-- ========== CLOSE BUTTON ========== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_about_close"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/about_close"
                android:textAllCaps="false"
                android:textSize="15sp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="16dp"
                app:rippleColor="#33FFFFFF" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</ScrollView>