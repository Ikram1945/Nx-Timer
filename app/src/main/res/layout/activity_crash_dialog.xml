<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/surface_bg">

    <!-- Icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚠️"
        android:textSize="64sp"
        android:layout_marginBottom="16dp" />

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/crash_title"
        android:textColor="@color/text_main"
        android:textSize="22sp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Message -->
    <TextView
        android:id="@+id/crash_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:gravity="center"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="16dp"
        android:maxLines="3"
        android:ellipsize="end" />

    <!-- Detail card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">

            <TextView
                android:id="@+id/crash_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_main"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textIsSelectable="true" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_crash_copy"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="8dp"
        android:text="@string/crash_copy"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:textSize="14sp"
        app:backgroundTint="@color/primary"
        app:cornerRadius="14dp"
        app:icon="@android:drawable/ic_menu_edit"
        app:iconGravity="textStart"
        app:rippleColor="#33FFFFFF" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_crash_whatsapp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="8dp"
        android:text="@string/crash_whatsapp"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:textSize="14sp"
        style="@style/Widget.Material3.Button.OutlinedButton"
        app:cornerRadius="14dp"
        app:icon="@android:drawable/ic_dialog_info"
        app:iconGravity="textStart" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_crash_restart"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="8dp"
        android:text="@string/crash_restart"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:textSize="14sp"
        android:backgroundTint="@color/primary"
        app:cornerRadius="14dp"
        app:icon="@android:drawable/ic_menu_rotate"
        app:iconGravity="textStart"
        app:rippleColor="#33FFFFFF" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_crash_close"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/crash_close"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:textSize="14sp"
        style="@style/Widget.Material3.Button.TextButton"
        app:cornerRadius="14dp" />

</LinearLayout>